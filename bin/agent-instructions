#!/bin/sh
# Print the global agent instructions as one document: agent/global.md followed by the reply style
# (agent/joint-ops-lite.md without its frontmatter). For agents that read a single global file.
#   sh ~/repo/dev-kit/bin/agent-instructions > ~/.codex/AGENTS.md
kit=$(cd "$(dirname "$0")/.." && pwd)
cat "$kit/agent/global.md"
printf '\n# Reply style\n\n'
awk 'NR == 1 && /^---$/ { fm = 1; next } fm && /^---$/ { fm = 0; next } !fm' "$kit/agent/joint-ops-lite.md" |
	sed '/./,$!d' | sed 's/^# /## /'
